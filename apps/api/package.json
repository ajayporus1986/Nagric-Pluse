{
  "name": "@np/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --watch --env-file-if-exists=../../.env dist/server.js",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "admin:bootstrap": "node --env-file-if-exists=../../.env dist/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@np/policy": "workspace:*",
    "@np/shared": "workspace:*",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
