# API and worker image (same image; the worker runs a different command).
# Multi-stage: build with dev dependencies, ship only production files, run as non-root.

FROM node:22-bookworm-slim AS build
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/policy/package.json packages/policy/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter "@np/api..."
COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter "@np/api..." run build \
 && pnpm --filter @np/api deploy --legacy --prod /out

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    MIGRATIONS_DIR=/app/db/migrations
WORKDIR /app
COPY --from=build --chown=root:root /out /app
COPY --chown=root:root db/migrations /app/db/migrations
COPY --chown=root:root districts /app/districts
# Application files are owned by root and read-only to the runtime user.
USER node
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.js"]
