# Copy to docker/.env and replace EVERY value. Never commit docker/.env.
# Generate passwords with:  openssl rand -base64 33
# Generate a 32-byte key:   openssl rand -base64 32

NP_DB_OWNER_PASSWORD=change-me
NP_DB_PASSWORD_PLATFORM=change-me-at-least-16-chars
NP_DB_PASSWORD_IAM=change-me-at-least-16-chars
NP_DB_PASSWORD_AUDIT=change-me-at-least-16-chars
NP_DB_PASSWORD_RELAY=change-me-at-least-16-chars
NP_DB_PASSWORD_REGISTRY=change-me-at-least-16-chars
NP_DB_PASSWORD_CITIZEN=change-me-at-least-16-chars

# Field encryption key ring "id:base64key[,id:base64key]" and the active id.
NP_FIELD_ENCRYPTION_KEYS=v1:REPLACE_WITH_32_BYTE_BASE64_KEY
NP_FIELD_ENCRYPTION_ACTIVE_KEY=v1

# Exact public origin of the console (https in production).
NP_PUBLIC_ORIGIN=https://nagrik-pulse.example.gov.in
NP_COOKIE_SECURE=true
NP_NODE_ENV=production

# For a local trial over plain http only:
#   NP_PUBLIC_ORIGIN=http://localhost:8081  NP_COOKIE_SECURE=false  NP_NODE_ENV=development

NP_HTTP_BIND=127.0.0.1
NP_HTTP_PORT=8081
NP_AUDIT_SIGNING_KEY_FILE=./secrets/audit-signing.pem

# Citizen OTP sign-in (see citizen/otp-sender.ts for why there is no direct
# SMS-gateway SDK here). "console" only logs the code and is refused outside
# development/test; "webhook" posts an HMAC-signed payload to your own
# SMS-gateway bridge.
NP_SMS_PROVIDER=console
# NP_SMS_PROVIDER=webhook
# NP_SMS_WEBHOOK_URL=https://your-sms-bridge.example.gov.in/send-otp
# NP_SMS_WEBHOOK_SECRET=change-me-at-least-16-chars
NP_OTP_TTL_SECONDS=300
NP_OTP_MAX_ATTEMPTS=5
NP_CITIZEN_SESSION_IDLE_MINUTES=30
NP_CITIZEN_SESSION_ABSOLUTE_HOURS=72
