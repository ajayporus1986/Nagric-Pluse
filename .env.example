# Copy to .env for local development only. Never commit real values.
NODE_ENV=development
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/nagrik_pulse
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=v1:REPLACE_ME
FIELD_ENCRYPTION_ACTIVE_KEY=v1
# Ed25519 private key (PKCS8 PEM path) used to sign audit checkpoints. Keep outside the database host.
AUDIT_SIGNING_KEY_FILE=./secrets/audit-signing.pem
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:5173
